{
  "name": "@shopai/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./states": {
      "types": "./dist/states.d.ts",
      "import": "./dist/states.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./states.css": "./src/states.css"
  },
  "dependencies": {
    "@shopai/contracts": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@shopai/config": "workspace:*"
  }
}
