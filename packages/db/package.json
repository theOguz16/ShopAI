{
  "name": "@shopai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@shopai/contracts": "workspace:*",
    "@shopai/commerce": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@shopai/config": "workspace:*",
    "drizzle-kit": "^0.31.0"
  }
}
