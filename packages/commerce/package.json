{
  "name": "@shopai/commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./catalog-health": {
      "types": "./dist/catalog-health.d.ts",
      "import": "./dist/catalog-health.js"
    },
    "./public-search": {
      "types": "./dist/public-search.d.ts",
      "import": "./dist/public-search.js"
    },
    "./category-facets": {
      "types": "./dist/category-facets.d.ts",
      "import": "./dist/category-facets.js"
    },
    "./product-detail": {
      "types": "./dist/product-detail.d.ts",
      "import": "./dist/product-detail.js"
    },
    "./merchant-conversions": {
      "types": "./dist/merchant-conversions.d.ts",
      "import": "./dist/merchant-conversions.js"
    },
    "./merchant-analytics": {
      "types": "./dist/merchant-analytics.d.ts",
      "import": "./dist/merchant-analytics.js"
    },
    "./product-views": {
      "types": "./dist/product-views.d.ts",
      "import": "./dist/product-views.js"
    },
    "./anonymous-shopping-profile": {
      "types": "./dist/anonymous-shopping-profile.d.ts",
      "import": "./dist/anonymous-shopping-profile.js"
    },
    "./product-alerts": {
      "types": "./dist/product-alerts.d.ts",
      "import": "./dist/product-alerts.js"
    }
  },
  "dependencies": {
    "@shopai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@shopai/config": "workspace:*"
  }
}
