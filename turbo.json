{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PILOT_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "CATALOG_MODE",
        "AUTH_PILOT_CREDENTIALS",
        "DEPLOY_ENV",
        "RELEASE_VERSION",
        "DATABASE_URL",
        "REDIS_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NEXT_PUBLIC_API_URL",
        "UPLOAD_DIR",
        "AI_PROVIDER",
        "OPENAI_API_KEY",
        "AI_MODEL",
        "AI_TIMEOUT_MS",
        "AI_MAX_OUTPUT_TOKENS",
        "AI_MAX_COST_USD",
        "AI_INPUT_USD_PER_MILLION",
        "AI_OUTPUT_USD_PER_MILLION",
        "MCP_PUBLIC_ORIGIN",
        "MCP_ALLOWED_ORIGINS",
        "WIDGET_ORIGIN",
        "WIDGET_RESOURCE_DOMAINS",
        "REDIRECT_SIGNING_SECRET",
        "REDIRECT_TOKEN_TTL_SECONDS",
        "CONVERSION_CALLBACK_SECRET"
      ]
    }
  }
}
