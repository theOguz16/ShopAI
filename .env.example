# Optional: copy to .env in the repository root for LOCAL development only.
# Never place live staging/production secret values in this file or commit them.
#
# Demo mode uses only in-memory sample data. DATABASE_URL and REDIS_URL are not
# read by the API in this mode.
HOST=127.0.0.1
PORT=4000
DEPLOY_ENV=local
RELEASE_VERSION=development
CATALOG_MODE=demo
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
LOG_LEVEL=info
# JSON secret map. Each code is valid only for its normalized email address.
# Staging/production must inject a different value from the secret manager.
AUTH_PILOT_CREDENTIALS={"pilot@shopai.local":"shopai-local-pilot-token"}
SESSION_TTL_HOURS=24
LOGIN_RATE_LIMIT_MAX=5
UPLOAD_DIR=private/uploads
# Deterministic parser is the safe default and makes local/CI tests key-free.
AI_PROVIDER=rules
# To enable the optional model parser, set AI_PROVIDER=openai and provide all
# values below from your account/budget. Rates are used only for per-request
# cost enforcement; do not commit a real key.
# OPENAI_API_KEY=
# AI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=2500
# AI_MAX_OUTPUT_TOKENS=300
# AI_MAX_COST_USD=0.002
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=

# MCP Apps / ChatGPT widget. Production/staging postgres mode requires HTTPS.
MCP_PUBLIC_ORIGIN=http://127.0.0.1:4000
WIDGET_ORIGIN=http://127.0.0.1:3001
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,https://chatgpt.com,https://chat.openai.com
# Explicit public image/static-asset origins only; never add private storage.
WIDGET_RESOURCE_DOMAINS=https://example.com
REDIRECT_SIGNING_SECRET=shopai-local-redirect-signing-key-change-me
REDIRECT_TOKEN_TTL_SECONDS=900
# Optional. Enables signed order callbacks and conversion reporting for newly
# created pilot connections. Use an independent deployment secret (32+ chars).
# CONVERSION_CALLBACK_SECRET=

# Real/local-infrastructure mode (replace CATALOG_MODE above with postgres).
# The API requires DATABASE_URL in postgres mode. The worker always requires
# both DATABASE_URL and REDIS_URL. These example credentials are local only.
# CATALOG_MODE=postgres
# DATABASE_URL=postgresql://shopai:shopai_local@127.0.0.1:54329/shopai
# REDIS_URL=redis://127.0.0.1:63799

# Product price/stock alert delivery. Alert evaluation runs after successful
# catalog sync even when these are unset; notifications remain pending until
# an email sender is configured. Set both values together in staging/prod.
# RESEND_API_KEY=re_replace
# ALERT_FROM_EMAIL=alerts@example.com

# WooCommerce pilot secret is injected into the worker environment by the
# deployment secret manager. The database stores only
# secret://WOOCOMMERCE_PILOT. Never commit a real value.
# WOOCOMMERCE_PILOT={"storeUrl":"https://shop.example","consumerKey":"ck_replace","consumerSecret":"cs_replace"}

# Hosted staging contract
# -----------------------
# These names belong in the GitHub Environment named `staging`; do NOT put
# their live values in .env files committed to the repository.
#
# GitHub Environment VARIABLES (non-secret):
# STAGING_API_ORIGIN=https://api.staging.<your-domain>
# STAGING_WIDGET_ORIGIN=https://widget.staging.<your-domain>
# STAGING_TLS_EMAIL=<ACME contact email>
# STAGING_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
# STAGING_RESOURCE_DOMAINS=https://widget.staging.<your-domain>,https://<pilot-image-origin>
# STAGING_MERCHANT_ID=<pilot merchant UUID>
# STAGING_BACKUP_DIR=<absolute secure directory on staging host>
#
# GitHub Environment SECRETS:
# STAGING_DATABASE_URL
# STAGING_REDIS_URL
# STAGING_REDIRECT_SIGNING_SECRET
# STAGING_AUTH_PILOT_CREDENTIALS
# STAGING_CONVERSION_CALLBACK_SECRET   # optional; empty disables callbacks
#
# Host prerequisites:
# - a self-hosted GitHub Actions runner labelled `shopai-staging`;
# - Docker + Docker Compose on that runner/host;
# - inbound TCP 80/443 (and optional UDP 443) for Caddy/ACME;
# - DNS A/AAAA records for both staging origins pointing at that host;
# - at least one published, purchasable pilot product for hosted acceptance.
